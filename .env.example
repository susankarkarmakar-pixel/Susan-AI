# Local development fallback. If Redis variables are absent, the app safely uses this bounded in-memory limiter.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_REQUESTS=30

# Optional: higher-quality live web search. Without this, Susan AI uses the no-key DuckDuckGo fallback.
# BRAVE_SEARCH_API_KEY=replace-me

# Public multi-instance deployment: set these in the hosting provider's secret/environment settings.
# The app uses the official @upstash/redis + @upstash/ratelimit integration.
# RATE_LIMIT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me
# TRUST_PROXY=true

# Opt-in live provider validation only; never commit real keys.
# RUN_LIVE_PROVIDER_TESTS=true
# SUSAN_TEST_PROVIDERS=openai,google
# OPENAI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# HUGGINGFACE_API_KEY=replace-me
# QWEN_API_KEY=replace-me
# KIMI_API_KEY=replace-me
# SARVAM_API_KEY=replace-me
# OPENROUTER_API_KEY=replace-me

# Google OAuth / Sign in with Google
# Add these values in Vercel Project Settings > Environment Variables.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# AUTH_URL=https://susan-ai.vercel.app

# Optional Sentry monitoring. Leave unset to keep monitoring disabled.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_AUTH_TOKEN= # build-time only, for source maps
# SENTRY_ORG= # build-time only
# SENTRY_PROJECT= # build-time only
